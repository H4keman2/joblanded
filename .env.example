# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real keys.

# Public/client-side Supabase config (safe to expose — protected by RLS)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""

# Server-only secrets — never prefix these with VITE_, never commit real
# values. Set these as secrets in your deployment platform (e.g. the Lovable
# project's secrets panel), not in a committed .env file.
SUPABASE_SERVICE_ROLE_KEY=""
LOVABLE_API_KEY=""

# Optional: job recommendations (free at https://developer.adzuna.com)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
